+/// Destination-specific language negotiation shared by native browser adapters.
+public enum CefNativeSiteLanguagePolicy {
+    public static let mainlandDomains = [
+        "cn", "xn--fiqs8s", "baidu.com", "bilibili.com", "zhihu.com",
+        "weibo.com", "qq.com", "163.com", "126.com", "taobao.com",
+        "tmall.com", "jd.com", "douban.com", "csdn.net"
+    ]
+
+    public static func prefersChinese(_ url: URL?) -> Bool {
+        guard let url, ["http", "https"].contains(url.scheme?.lowercased() ?? ""),
+              let host = url.host?.lowercased() else { return false }
+        let normalized = host.trimmingCharacters(in: CharacterSet(charactersIn: "."))
+        return mainlandDomains.contains { normalized == $0 || normalized.hasSuffix("." + $0) }
+    }
+
+    public static let acceptLanguage = "zh-CN,zh;q=0.9,en;q=0.8"
+}
