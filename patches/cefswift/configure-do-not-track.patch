+    @discardableResult
+    public func setDoNotTrackEnabled(_ enabled: Bool) -> Bool {
+        precondition(Thread.isMainThread, "CEF preferences must be changed on the main thread.")
+        guard isInitialized,
+              let context = cef_request_context_get_global_context() else {
+            return false
+        }
+        defer { cefRelease(UnsafeMutableRawPointer(context)) }
+        configuration?.doNotTrackEnabled = enabled
