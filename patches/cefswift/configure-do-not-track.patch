@@ -1,6 +1,37 @@
 import CCef
 import Foundation
 
+enum CefBuiltInPreference {
+    static let doNotTrack = "enable_do_not_track"
+
+    static func setBoolean(
+        _ value: Bool,
+        forKey key: String,
+        in context: UnsafeMutablePointer<cef_request_context_t>
+    ) -> String? {
+        guard let cefValue = cef_value_create() else {
+            return "CEF could not allocate a preference value."
+        }
+        defer { cefRelease(UnsafeMutableRawPointer(cefValue)) }
+        guard cefValue.pointee.set_bool?(cefValue, value ? 1 : 0) != 0 else {
+            return "CEF rejected the Boolean preference value."
+        }
+
+        var error = cef_string_t()
+        defer { ccef_string_clear(&error) }
+        let succeeded = CefStringUtil.withCefString(key) { cefKey in
+            withUnsafeMutablePointer(to: &context.pointee.base) { manager in
+                manager.pointee.set_preference?(manager, cefKey, cefValue, &error) ?? 0
+            }
+        }
+        guard succeeded != 0 else {
+            let message = CefStringUtil.string(from: error)
+            return message.isEmpty ? "CEF rejected the browser preference." : message
+        }
+        return nil
+    }
+}
