+    /// Fetches media with this profile's Chromium network context and cookie store.
+    public func fetchMediaResource(url: URL, headers: [String: String]) async -> CefMediaResourceResponse? {
+        let transfer = CefMediaResourceRequest()
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in
+                transfer.continuation = continuation
+                guard !Task.isCancelled, withHost({ transfer.start(host: $0, url: url, headers: headers) }) == true else {
+                    transfer.finish(nil)
+                    return
+                }
+            }
+        } onCancel: {
+            Task { @MainActor in transfer.cancel() }
