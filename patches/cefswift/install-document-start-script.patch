+@Suite struct CefDocumentStartScriptTests {
+    @Test func childSwitchSerializationRoundTripsUnicodeJavaScript() {
+        let script = "globalThis.__policy = '✓';"
+        let encoded = CefDocumentStartScript.serialize(script)
+        let arguments = [
+            "/path/to/Helper",
+            "--type=renderer",
+            "--\(CefDocumentStartScript.childProcessSwitchName)=\(encoded)",
+        ]
+
+        #expect(CefDocumentStartScript.parse(fromArguments: arguments) == script)
+    }
+
+    @Test func absentOrMalformedSwitchReturnsNil() {
+        #expect(CefDocumentStartScript.parse(fromArguments: ["--type=renderer"]) == nil)
+        #expect(CefDocumentStartScript.parse(fromArguments: [
+            "--\(CefDocumentStartScript.childProcessSwitchName)=***"
+        ]) == nil)
+    }
+}
