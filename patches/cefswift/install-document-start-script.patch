+/// Encodes an optional document-start script onto renderer helper command
+/// lines. Base64 keeps JavaScript punctuation out of Chromium switch parsing.
+enum CefDocumentStartScript {
+    static let childProcessSwitchName = "cefswift-document-start-script"
+
+    static func serialize(_ script: String) -> String {
+        Data(script.utf8).base64EncodedString()
+    }
+
+    static func parse(fromArguments arguments: [String]) -> String? {
+        let prefix = "--\(childProcessSwitchName)="
+        guard let argument = arguments.first(where: { $0.hasPrefix(prefix) }),
+              let data = Data(base64Encoded: String(argument.dropFirst(prefix.count)))
+        else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+}
