    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf „Schreibtisch“ ist erforderlich, um Dateien in Astra Browser zugänglich zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access to \"Desktop\" is required to make files accessible from Astra Browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a \"Escritorio\" para poder acceder a los archivos desde Astra Browser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au dossier « Bureau » est nécessaire pour rendre les fichiers accessibles depuis Astra Browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astra Browserからファイルにアクセスできるようにするには、「デスクトップ」へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astra Browser에서 파일에 접근할 수 있게 하려면 \"데스크탑\" 접근 권한이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot \"Bureaublad\" is vereist om bestanden toegankelijk te maken vanuit Astra Browser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问「桌面」文件夹，才能在 Astra Browser 中访问其中的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要取用「桌面」，才能在 Astra Browser 中存取檔案。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Privacy - Downloads Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf „Downloads“ ist erforderlich, um Dateien aus dem Internet herunterzuladen und Dateien in Astra Browser zugänglich zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access to \"Downloads\" is required for downloading files from the web and to make files accessible from Astra Browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a \"Descargas\" para descargar archivos de la web y poder acceder a los archivos desde Astra Browser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au dossier « Téléchargements » est nécessaire pour télécharger des fichiers depuis Internet et rendre les fichiers accessibles depuis Astra Browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webからファイルをダウンロードし、Astra Browserからファイルにアクセスできるようにするには、「ダウンロード」へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹에서 파일을 다운로드하고 Astra Browser에서 파일에 접근할 수 있게 하려면 \"다운로드\" 접근 권한이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot \"Downloads\" is vereist om bestanden van internet te downloaden en om bestanden toegankelijk te maken vanuit Astra Browser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问「下载」文件夹，才能从网络下载文件，并在 Astra Browser 中访问其中的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要取用「下載項目」，才能從網路下載檔案，並在 Astra Browser 中存取檔案。"
          }
        }
      }
    },
