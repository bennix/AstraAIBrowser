// Shared Configuration for all builds

// Module Name (must be same for both versions for Swift bridging)
PRODUCT_MODULE_NAME = Phi

// Product Directory Name
CR_PRODUCT_DIR_NAME = ${PRODUCT_BUNDLE_IDENTIFIER}

// Astra uses ZenMux without the legacy Phi account authentication flow.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) ASTRA_ZENMUX_BUILD
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) ASTRA_ZENMUX_BUILD=1
